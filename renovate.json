{
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "baseBranches": [
    "dev"
  ],
  "reviewers": [
    "xknat"
  ],
  "ignoreDeps": [
    "org.spigotmc:spigot-api",
    "net.fabricmc.fabric-api:fabric-api-bom",
    "net.fabricmc.fabric-api:fabric-api",
    "dev.architectury.loom-no-remap"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": [
        "**"
      ],
      "allowedVersions": "!/\\-SNAPSHOT$/"
    },
    {
      "description": "OpenRewrite 7.40.0 and 7.41.0 require the unpublished rewrite-bom 8.91.0.",
      "matchPackageNames": [
        "org.openrewrite:plugin"
      ],
      "allowedVersions": "!/^7\\.(40|41)\\.0$/"
    }
  ]
}
